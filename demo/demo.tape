# Record with: vhs demo/demo.tape   (run from the repository root)
Output demo/demo.gif
Set Shell bash
Set FontSize 15
Set Width 1100
Set Height 560
Set Padding 16
Set TypingSpeed 60ms

Hide
Type "source demo/setup.sh && clear" Enter
Sleep 8s
Show

Type "flutterkill --dry-run" Sleep 400ms Enter
Sleep 2s
Type "l" Sleep 800ms
Down Sleep 400ms
Space Sleep 400ms
Down Sleep 300ms
Space Sleep 800ms
Type "s" Sleep 800ms
Type "s" Sleep 800ms
Type "a" Sleep 800ms
Type "d" Sleep 2s
Type "y" Sleep 1.5s
Tab Sleep 1.5s
Type "q" Sleep 1.5s

Hide
Type "rm -rf /tmp/flutterkill-demo /private/tmp/flutterkill-demo" Enter
